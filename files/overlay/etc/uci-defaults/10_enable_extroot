#!/bin/sh
# /etc/uci-defaults/10_enable_extroot
# This script runs once on first boot. It attempts to mount two USB partitions:
# 1. overlay partition (3.6G) to /overlay
# 2. data partition (3.6G) to /data
# Both partitions are ext4 formatted and labeled accordingly

set -e

LOG=/tmp/enable_extroot.log
echo "enable_extroot: starting" > "$LOG"

# wait a short time for disks to settle
sleep 2

# Function to mount and setup a partition
mount_partition() {
	local label=$1
	local target=$2
	local partition_size=$3
	
	echo "enable_extroot: processing $label partition for $target" >> "$LOG"
	
	if [ ! -e /dev/disk/by-label/$label ]; then
		echo "enable_extroot: no /dev/disk/by-label/$label found" >> "$LOG"
		return 1
	fi
	
	local MNT=/mnt/${label}_tmp
	mkdir -p "$MNT"
	
	if mount /dev/disk/by-label/$label "$MNT"; then
		echo "enable_extroot: mounted $label partition to $MNT" >> "$LOG"
		
		# If the target is empty (new), copy existing contents if applicable
		if [ -d "$target" ] && [ -z "$(ls -A "$MNT" 2>/dev/null)" ]; then
			echo "enable_extroot: copying current $target contents to USB $label partition" >> "$LOG"
			# Use tar to preserve permissions
			tar -C "$target" -cf - . | tar -C "$MNT" -xf - || true
		fi
		
		umount "$MNT" || true
		rmdir "$MNT" || true
		return 0
	else
		echo "enable_extroot: failed to mount $label partition" >> "$LOG"
		rmdir "$MNT" || true
		return 1
	fi
}

# Mount overlay partition (3.6G ext4)
mount_partition "overlay" "/overlay" "3.6G"

# Mount data partition (3.6G ext4)
mount_partition "data" "/data" "3.6G"

# Enable both fstab entries
if command -v uci >/dev/null 2>&1; then
	echo "enable_extroot: enabling fstab entries" >> "$LOG"
	
	# Enable overlay mount
	uci set fstab.@mount[0].enabled='1' || true
	
	# Enable data mount (second mount point)
	uci set fstab.@mount[1].enabled='1' || true
	
	uci commit fstab || true
fi

# Enable block-mount init script if present
if [ -x /etc/init.d/fstab ]; then
	/etc/init.d/fstab enable || true
	echo "enable_extroot: enabled block-mount service" >> "$LOG"
fi

# Clean up: remove this script (uci-defaults files are removed after execution, but keep safe)
[ -f /etc/uci-defaults/10_enable_extroot ] && rm -f /etc/uci-defaults/10_enable_extroot || true

echo "enable_extroot: done" >> "$LOG"

exit 0
