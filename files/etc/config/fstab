config global automount
	option from_fstab '1'
	option anon_mount '1'

config global autoswap
	option from_fstab '1'
	option anon_swap '0'

config global mount
	option auto_mount '1'
	option delay_root '10'
	option check_fs '0'


config mount
	option target '/overlay'
	option device 'LABEL=overlay'
	option fstype 'ext4'
	option options 'rw,noatime'
	option enabled '1'


config mount
	option target '/mnt/data'
	option device 'LABEL=data'
	option fstype 'ext4'
	option options 'rw,noatime'
	option enabled '1'
